@rendermode InteractiveServer
@inject NotaService NotaService

<div class="sidebar-nav">
    <nav class="nav flex-column">
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.75L12 3l9 6.75V21a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.75z"/><path d="M9 22V12h6v10"/></svg>
                Início
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="notas">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="7" y1="8" x2="17" y2="8"/><line x1="7" y1="12" x2="17" y2="12"/><line x1="7" y1="16" x2="13" y2="16"/></svg>
                Notas
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="tarefas">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4"/></svg>
                Tarefas
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="arquivos">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66L9.41 17.41a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                Arquivos
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="calendario">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                Calendário
            </NavLink>
        </div>

        <div class="nav-item">
            <div class="nav-cadernos-header">
                <NavLink class="nav-link" href="cadernos">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                    Cadernos
                </NavLink>
                <button class="btn-chevron-cadernos @(_expandirCadernos ? "expandido" : "")"
                        @onclick="ToggleCadernos"
                        title="@(_expandirCadernos ? "Recolher cadernos" : "Expandir cadernos")">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6" />
                    </svg>
                </button>
            </div>
            @if (_expandirCadernos)
            {
                <div class="nav-cadernos-lista">
                    @foreach (var caderno in NotaService.Cadernos)
                    {
                        <a class="nav-caderno-item" href="/notas?caderno=@caderno.Id">
                            <span class="nav-caderno-nome">@caderno.Nome</span>
                            <span class="nav-caderno-contagem">@NotaService.ContarNotasNoCaderno(caderno.Id)</span>
                        </a>
                    }
                </div>
            }
        </div>

        <div class="nav-separador"></div>

        <div class="nav-item">
            <NavLink class="nav-link nav-link-lixeira" href="lixeira">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                Lixeira
            </NavLink>
        </div>
    </nav>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

@code {
    private bool _expandirCadernos = false;

    private void ToggleCadernos() => _expandirCadernos = !_expandirCadernos;
}
