@page "/tarefas"
@rendermode InteractiveServer
@inject TarefaService TarefaService

<PageTitle>Tarefas</PageTitle>

<div class="tarefas-layout">

    <!-- Cabeçalho -->
    <div class="tarefas-header">
        <h1 class="tarefas-titulo">Tarefas</h1>
        <button class="btn-nova-tarefa" @onclick="AbrirModal">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
            Nova Tarefa
        </button>
    </div>

    <!-- Abas -->
    <div class="tarefas-abas">
        <button class="aba @(_abaAtiva == "ativas" ? "aba-ativa" : "")" @onclick='() => _abaAtiva = "ativas"'>
            Minhas tarefas
            @if (TarefaService.TotalAtivas > 0)
            {
                <span class="aba-contagem">@TarefaService.TotalAtivas</span>
            }
        </button>
        <button class="aba @(_abaAtiva == "hoje" ? "aba-ativa" : "")" @onclick='() => _abaAtiva = "hoje"'>
            Hoje
            @{ var totalHoje = TarefaService.TarefasHoje.Count; }
            @if (totalHoje > 0)
            {
                <span class="aba-contagem">@totalHoje</span>
            }
        </button>
        <button class="aba @(_abaAtiva == "sinalizadas" ? "aba-ativa" : "")" @onclick='() => _abaAtiva = "sinalizadas"'>
            Sinalizadas
            @{ var totalSinalizadas = TarefaService.TarefasSinalizadas.Count; }
            @if (totalSinalizadas > 0)
            {
                <span class="aba-contagem">@totalSinalizadas</span>
            }
        </button>
        <button class="aba @(_abaAtiva == "concluidas" ? "aba-ativa" : "")" @onclick='() => _abaAtiva = "concluidas"'>
            Concluídas
        </button>
    </div>

    <!-- Busca -->
    <div class="tarefas-busca-wrap">
        <svg class="busca-icone" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <input class="tarefas-busca" type="search" placeholder="Buscar tarefas..."
               @bind="_busca" @bind:event="oninput" />
    </div>

    <!-- Lista -->
    <div class="tarefas-lista">
        @{
            var lista = ListaFiltrada();
        }
        @if (!lista.Any())
        {
            <div class="tarefas-vazia">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M9 12l2 2 4-4" />
                </svg>
                <span>Nenhuma tarefa aqui</span>
            </div>
        }
        else
        {
            @foreach (var tarefa in lista)
            {
                <div class="tarefa-item @(tarefa.Concluida ? "tarefa-concluida" : "")">
                    <button class="tarefa-check" @onclick="() => ToggleConcluida(tarefa)" title="@(tarefa.Concluida ? "Reabrir" : "Concluir")">
                        @if (tarefa.Concluida)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="9" />
                                <path d="M9 12l2 2 4-4" />
                            </svg>
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="9" />
                            </svg>
                        }
                    </button>

                    <div class="tarefa-corpo" @onclick="() => AbrirEdicao(tarefa)">
                        <span class="tarefa-titulo-texto">@tarefa.Titulo</span>
                        <div class="tarefa-meta">
                            @if (tarefa.DataVencimento.HasValue)
                            {
                                var vencida = !tarefa.Concluida && tarefa.DataVencimento.Value.Date < DateTime.Today;
                                <span class="tarefa-data @(vencida ? "tarefa-data-vencida" : "")">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="4" width="18" height="18" rx="2" />
                                        <line x1="16" y1="2" x2="16" y2="6" />
                                        <line x1="8" y1="2" x2="8" y2="6" />
                                        <line x1="3" y1="10" x2="21" y2="10" />
                                    </svg>
                                    @FormatarData(tarefa.DataVencimento.Value)
                                </span>
                            }
                            @if (tarefa.Prioridade != Prioridade.Nenhuma)
                            {
                                <span class="tarefa-prioridade prioridade-@tarefa.Prioridade.ToString().ToLower()">
                                    @tarefa.Prioridade
                                </span>
                            }
                            @if (tarefa.Recorrencia != TipoRecorrencia.Nenhuma)
                            {
                                <span class="tarefa-recorrencia-badge" title="@ResumirRecorrenciaTarefa(tarefa)">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/>
                                    </svg>
                                </span>
                            }
                        </div>
                    </div>

                    <div class="tarefa-acoes">
                        <button class="btn-sinalizar @(tarefa.Sinalizada ? "sinalizada" : "")"
                                @onclick="() => ToggleSinalizar(tarefa)" title="@(tarefa.Sinalizada ? "Remover sinalização" : "Sinalizar")">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                 fill="@(tarefa.Sinalizada ? "currentColor" : "none")"
                                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z" />
                                <line x1="4" y1="22" x2="4" y2="15" />
                            </svg>
                        </button>
                        <button class="btn-excluir" @onclick="() => Excluir(tarefa)" title="Excluir">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="3 6 5 6 21 6" />
                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                <path d="M10 11v6M14 11v6" />
                                <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                            </svg>
                        </button>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Modal Nova/Editar Tarefa -->
@if (_modalAberto)
{
    <div class="modal-overlay" @onclick="FecharModal">
        <div class="modal-dialogo" @onclick:stopPropagation="true">
            <div class="modal-cabecalho">
                <h2 class="modal-titulo">@(_tarefaEditando == null ? "Nova Tarefa" : "Editar Tarefa")</h2>
                <button class="modal-fechar" @onclick="FecharModal">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                    </svg>
                </button>
            </div>

            <div class="modal-corpo">
                <!-- Título -->
                <div class="campo">
                    <label class="campo-label">Título</label>
                    <input class="campo-input" type="text" placeholder="Digite o título da tarefa..."
                           @bind="_form.Titulo" @bind:event="oninput" autofocus />
                </div>

                <!-- Descrição -->
                <div class="campo">
                    <label class="campo-label">Descrição</label>
                    <textarea class="campo-textarea" placeholder="Adicione uma descrição..."
                              @bind="_form.Descricao" @bind:event="oninput" rows="3"></textarea>
                </div>

                <!-- Data de vencimento -->
                <div class="campo">
                    <label class="campo-label">Data de vencimento</label>
                    <div class="chips-data">
                        <button class="chip @(_form.DataVencimento?.Date == DateTime.Today ? "chip-ativo" : "")"
                                @onclick="() => DefinirData(_form.DataVencimento?.Date == DateTime.Today ? null : (DateTime?)DateTime.Today)">
                            Hoje
                        </button>
                        <button class="chip @(_form.DataVencimento?.Date == DateTime.Today.AddDays(1).Date ? "chip-ativo" : "")"
                                @onclick="() => DefinirData(_form.DataVencimento?.Date == DateTime.Today.AddDays(1).Date ? null : (DateTime?)DateTime.Today.AddDays(1))">
                            Amanhã
                        </button>
                        <button class="chip @(_form.DataVencimento?.Date == ProximaSemana.Date ? "chip-ativo" : "")"
                                @onclick="() => DefinirData(_form.DataVencimento?.Date == ProximaSemana.Date ? null : (DateTime?)ProximaSemana)">
                            Próxima semana
                        </button>
                        <input class="campo-data" type="date"
                               value="@(_form.DataVencimento?.ToString("yyyy-MM-dd") ?? "")"
                               @onchange="e => DefinirData(string.IsNullOrEmpty(e.Value?.ToString()) ? null : (DateTime?)DateTime.Parse(e.Value!.ToString()!))" />
                    </div>
                    @if (_form.DataVencimento.HasValue)
                    {
                        <div class="campo-hora-wrap">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="9" />
                                <polyline points="12 7 12 12 15.5 12" />
                            </svg>
                            <input class="campo-hora" type="time"
                                   value="@(_form.Hora)"
                                   @onchange="e => _form.Hora = e.Value?.ToString() ?? string.Empty"
                                   placeholder="Hora (opcional)" />
                            @if (!string.IsNullOrEmpty(_form.Hora))
                            {
                                <button class="btn-limpar-hora" @onclick='() => _form.Hora = ""' title="Remover hora">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
                                    </svg>
                                </button>
                            }
                        </div>
                    }
                </div>

                <!-- Prioridade -->
                <div class="campo">
                    <label class="campo-label">Prioridade</label>
                    <div class="chips-prioridade">
                        @foreach (var p in Enum.GetValues<Prioridade>())
                        {
                            <button class="chip chip-prioridade-@p.ToString().ToLower() @(_form.Prioridade == p ? "chip-ativo" : "")"
                                    @onclick="() => _form.Prioridade = _form.Prioridade == p ? Prioridade.Nenhuma : p">
                                @p
                            </button>
                        }
                    </div>
                </div>

                <!-- Sinalizar -->
                <div class="campo campo-sinalizar">
                    <label class="campo-label">Sinalizar</label>
                    <button class="toggle-sinalizar @(_form.Sinalizada ? "ativo" : "")"
                            @onclick="() => _form.Sinalizada = !_form.Sinalizada">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                             fill="@(_form.Sinalizada ? "currentColor" : "none")"
                             stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z" />
                            <line x1="4" y1="22" x2="4" y2="15" />
                        </svg>
                        @(_form.Sinalizada ? "Sinalizada" : "Não sinalizada")
                    </button>
                </div>

                <!-- Recorrência -->
                <div class="campo campo-sinalizar">
                    <label class="campo-label">Recorrência</label>
                    <button class="toggle-sinalizar @(_form.Recorrencia != TipoRecorrencia.Nenhuma ? "ativo" : "")"
                            @onclick="AbrirRecorrencia">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/>
                        </svg>
                        @(_form.Recorrencia == TipoRecorrencia.Nenhuma ? "Sem recorrência" : ResumirRecorrenciaForm())
                    </button>
                </div>
            </div>

            <div class="modal-rodape">
                <button class="btn-cancelar" @onclick="FecharModal">Cancelar</button>
                <button class="btn-salvar" @onclick="Salvar" disabled="@(string.IsNullOrWhiteSpace(_form.Titulo))">
                    @(_tarefaEditando == null ? "Criar tarefa" : "Salvar")
                </button>
            </div>
        </div>
    </div>
}

<!-- Painel de Recorrência -->
@if (_recorrenciaAberta)
{
    <div class="recorrencia-overlay" @onclick="CancelarRecorrencia">
        <div class="recorrencia-dialogo" @onclick:stopPropagation="true">
            <h2 class="recorrencia-titulo">Recorrência personalizada</h2>

            <!-- Repete -->
            <div class="rec-campo">
                <label class="rec-label">Repete</label>
                <select class="rec-select" @bind="_recTipo">
                    <option value="@TipoRecorrencia.Diaria">Diariamente</option>
                    <option value="@TipoRecorrencia.Semanal">Semanalmente</option>
                    <option value="@TipoRecorrencia.Mensal">Mensalmente</option>
                    <option value="@TipoRecorrencia.Anual">Anualmente</option>
                </select>
            </div>

            <!-- Intervalo -->
            <div class="rec-campo">
                <label class="rec-label">Intervalo</label>
                <div class="rec-intervalo">
                    <div class="rec-spinner">
                        <button class="rec-spinner-btn" @onclick="() => _recIntervalo = Math.Max(1, _recIntervalo - 1)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18 15 12 9 6 15"/></svg>
                        </button>
                        <span class="rec-spinner-val">@_recIntervalo</span>
                        <button class="rec-spinner-btn" @onclick="() => _recIntervalo++">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
                        </button>
                    </div>
                    <span class="rec-unidade">@UnidadeIntervalo()</span>
                </div>
            </div>

            <!-- Nos dias (só para semanal) -->
            @if (_recTipo == TipoRecorrencia.Semanal)
            {
                <div class="rec-campo">
                    <label class="rec-label">Nos dias</label>
                    <div class="rec-dias">
                        @foreach (var dia in _diasSemana)
                        {
                            var selecionado = _recDias.Contains(dia.Key);
                            <button class="rec-dia @(selecionado ? "rec-dia-ativo" : "")"
                                    @onclick="() => ToggleDia(dia.Key)">
                                @dia.Value
                            </button>
                        }
                    </div>
                </div>
            }

            <!-- Começa em -->
            <div class="rec-campo">
                <label class="rec-label">Começa em</label>
                <input class="rec-input-data" type="date"
                       value="@(_recInicio.ToString("yyyy-MM-dd"))"
                       @onchange="e => _recInicio = string.IsNullOrEmpty(e.Value?.ToString()) ? DateTime.Today : DateTime.Parse(e.Value!.ToString()!)" />
            </div>

            <!-- Termina em -->
            <div class="rec-campo">
                <label class="rec-label">Termina em</label>
                <div class="rec-termina">
                    <label class="rec-radio-label">
                        <input type="radio" name="termina" checked="@_recTerminaNunca"
                               @onchange="() => _recTerminaNunca = true" />
                        Nunca
                    </label>
                    <label class="rec-radio-label">
                        <input type="radio" name="termina" checked="@(!_recTerminaNunca)"
                               @onchange="() => _recTerminaNunca = false" />
                        Em
                        <input class="rec-input-data" type="date"
                               disabled="@_recTerminaNunca"
                               value="@(_recFim?.ToString("yyyy-MM-dd") ?? "")"
                               @onchange="e => _recFim = string.IsNullOrEmpty(e.Value?.ToString()) ? null : (DateTime?)DateTime.Parse(e.Value!.ToString()!)" />
                    </label>
                </div>
            </div>

            <!-- Resumo -->
            <div class="rec-resumo">@ResumirRecorrenciaForm()</div>

            <div class="rec-rodape">
                <button class="btn-cancelar" @onclick="CancelarRecorrencia">Cancelar</button>
                <button class="btn-salvar" @onclick="ConfirmarRecorrencia">Pronto</button>
            </div>
        </div>
    </div>
}

@code {
    private string _abaAtiva = "ativas";
    private string _busca = "";
    private bool _modalAberto = false;
    private Tarefa? _tarefaEditando = null;

    private FormTarefa _form = new();

    // ── Recorrência ──────────────────────────────────────────────────────────
    private bool _recorrenciaAberta = false;
    private TipoRecorrencia _recTipo = TipoRecorrencia.Semanal;
    private int _recIntervalo = 1;
    private HashSet<DayOfWeek> _recDias = new();
    private DateTime _recInicio = DateTime.Today;
    private DateTime? _recFim = null;
    private bool _recTerminaNunca = true;

    private static readonly Dictionary<DayOfWeek, string> _diasSemana = new()
    {
        { DayOfWeek.Sunday,    "D" },
        { DayOfWeek.Monday,    "S" },
        { DayOfWeek.Tuesday,   "T" },
        { DayOfWeek.Wednesday, "Q" },
        { DayOfWeek.Thursday,  "Q" },
        { DayOfWeek.Friday,    "S" },
        { DayOfWeek.Saturday,  "S" },
    };

    private DateTime ProximaSemana =>
        DateTime.Today.AddDays(7 - (int)DateTime.Today.DayOfWeek + 1);

    private class FormTarefa
    {
        public string Titulo { get; set; } = "";
        public string Descricao { get; set; } = "";
        public DateTime? DataVencimento { get; set; }
        public string Hora { get; set; } = "";
        public Prioridade Prioridade { get; set; } = Prioridade.Nenhuma;
        public bool Sinalizada { get; set; } = false;
        public TipoRecorrencia Recorrencia { get; set; } = TipoRecorrencia.Nenhuma;
        public int IntervaloRecorrencia { get; set; } = 1;
        public HashSet<DayOfWeek> DiasSemanais { get; set; } = new();
        public DateTime? RecorrenciaFim { get; set; }
    }

    private static string FormatarData(DateTime dt) =>
        dt.TimeOfDay == TimeSpan.Zero ? dt.ToString("dd/MM/yyyy") : dt.ToString("dd/MM/yyyy HH:mm");

    // Define a data preservando a hora já digitada
    private void DefinirData(DateTime? novaData)
    {
        if (novaData == null) { _form.DataVencimento = null; return; }
        _form.DataVencimento = novaData.Value.Date;
    }

    private List<Tarefa> ListaFiltrada()
    {
        var lista = _abaAtiva switch
        {
            "hoje"       => TarefaService.TarefasHoje,
            "sinalizadas"=> TarefaService.TarefasSinalizadas,
            "concluidas" => TarefaService.TarefasConcluidas,
            _            => TarefaService.TarefasAtivas,
        };

        if (!string.IsNullOrWhiteSpace(_busca))
            lista = lista.Where(t =>
                t.Titulo.Contains(_busca, StringComparison.OrdinalIgnoreCase) ||
                t.Descricao.Contains(_busca, StringComparison.OrdinalIgnoreCase)).ToList();

        return lista;
    }

    private void AbrirModal()
    {
        _tarefaEditando = null;
        _form = new FormTarefa();
        _modalAberto = true;
    }

    private void AbrirEdicao(Tarefa tarefa)
    {
        _tarefaEditando = tarefa;
        _form = new FormTarefa
        {
            Titulo              = tarefa.Titulo,
            Descricao           = tarefa.Descricao,
            DataVencimento      = tarefa.DataVencimento?.Date,
            Hora                = tarefa.DataVencimento?.TimeOfDay == TimeSpan.Zero ? "" : tarefa.DataVencimento?.ToString("HH:mm") ?? "",
            Prioridade          = tarefa.Prioridade,
            Sinalizada          = tarefa.Sinalizada,
            Recorrencia         = tarefa.Recorrencia,
            IntervaloRecorrencia= tarefa.IntervaloRecorrencia,
            DiasSemanais        = DeserializarDias(tarefa.DiasSemanais),
            RecorrenciaFim      = tarefa.RecorrenciaFim,
        };
        _modalAberto = true;
    }

    private void FecharModal() => _modalAberto = false;

    // ── Recorrência ──────────────────────────────────────────────────────────

    private void AbrirRecorrencia()
    {
        _recTipo         = _form.Recorrencia == TipoRecorrencia.Nenhuma ? TipoRecorrencia.Semanal : _form.Recorrencia;
        _recIntervalo    = _form.IntervaloRecorrencia < 1 ? 1 : _form.IntervaloRecorrencia;
        _recDias         = new HashSet<DayOfWeek>(_form.DiasSemanais);
        _recInicio       = _form.DataVencimento ?? DateTime.Today;
        _recFim          = _form.RecorrenciaFim;
        _recTerminaNunca = _form.RecorrenciaFim == null;
        _recorrenciaAberta = true;
    }

    private void CancelarRecorrencia() => _recorrenciaAberta = false;

    private void ConfirmarRecorrencia()
    {
        _form.Recorrencia          = _recTipo;
        _form.IntervaloRecorrencia = _recIntervalo;
        _form.DiasSemanais         = new HashSet<DayOfWeek>(_recDias);
        _form.RecorrenciaFim       = _recTerminaNunca ? null : _recFim;
        _recorrenciaAberta = false;
    }

    private void ToggleDia(DayOfWeek dia)
    {
        if (!_recDias.Remove(dia)) _recDias.Add(dia);
    }

    private string UnidadeIntervalo() => _recTipo switch
    {
        TipoRecorrencia.Diaria  => _recIntervalo == 1 ? "dia"    : "dias",
        TipoRecorrencia.Semanal => _recIntervalo == 1 ? "semana" : "semanas",
        TipoRecorrencia.Mensal  => _recIntervalo == 1 ? "mês"    : "meses",
        TipoRecorrencia.Anual   => _recIntervalo == 1 ? "ano"    : "anos",
        _ => ""
    };

    private string ResumirRecorrenciaForm()
    {
        var tipo      = _recorrenciaAberta ? _recTipo      : _form.Recorrencia;
        var intervalo = _recorrenciaAberta ? _recIntervalo : _form.IntervaloRecorrencia;
        var dias      = _recorrenciaAberta ? _recDias      : _form.DiasSemanais;

        return tipo switch
        {
            TipoRecorrencia.Nenhuma => "Sem recorrência",
            TipoRecorrencia.Diaria  => intervalo == 1 ? "Diariamente" : $"A cada {intervalo} dias",
            TipoRecorrencia.Semanal => GerarResumoSemanal(intervalo, dias),
            TipoRecorrencia.Mensal  => intervalo == 1 ? "Mensalmente" : $"A cada {intervalo} meses",
            TipoRecorrencia.Anual   => "Anualmente",
            _ => ""
        };
    }

    private static string ResumirRecorrenciaTarefa(Tarefa t) => t.Recorrencia switch
    {
        TipoRecorrencia.Diaria  => t.IntervaloRecorrencia == 1 ? "Diariamente" : $"A cada {t.IntervaloRecorrencia} dias",
        TipoRecorrencia.Semanal => GerarResumoSemanal(t.IntervaloRecorrencia, DeserializarDias(t.DiasSemanais)),
        TipoRecorrencia.Mensal  => t.IntervaloRecorrencia == 1 ? "Mensalmente" : $"A cada {t.IntervaloRecorrencia} meses",
        TipoRecorrencia.Anual   => "Anualmente",
        _ => ""
    };

    private static string GerarResumoSemanal(int intervalo, IEnumerable<DayOfWeek> dias)
    {
        var lista = dias.OrderBy(d => (int)d).Select(NomeDia).ToList();
        var diasStr = lista.Count == 0 ? "" : string.Join(", ", lista);
        var prefixo = intervalo == 1 ? "Semanal" : $"A cada {intervalo} semanas";
        return lista.Count == 0 ? $"{prefixo}." : $"{prefixo} em {diasStr}.";
    }

    private static string NomeDia(DayOfWeek d) => d switch
    {
        DayOfWeek.Sunday    => "Domingo",
        DayOfWeek.Monday    => "Segunda-feira",
        DayOfWeek.Tuesday   => "Terça-feira",
        DayOfWeek.Wednesday => "Quarta-feira",
        DayOfWeek.Thursday  => "Quinta-feira",
        DayOfWeek.Friday    => "Sexta-feira",
        DayOfWeek.Saturday  => "Sábado",
        _ => ""
    };

    private static HashSet<DayOfWeek> DeserializarDias(string raw) =>
        new(raw.Split(',', StringSplitOptions.RemoveEmptyEntries)
               .Select(s => int.TryParse(s, out var n) ? (DayOfWeek?)n : null)
               .Where(d => d.HasValue).Select(d => d!.Value));

    private static string SerializarDias(IEnumerable<DayOfWeek> dias) =>
        string.Join(",", dias.Cast<int>().OrderBy(d => d));

    private DateTime? CombinarDataHora()
    {
        if (_form.DataVencimento == null) return null;
        if (!string.IsNullOrEmpty(_form.Hora) && TimeSpan.TryParse(_form.Hora, out var hora))
            return _form.DataVencimento.Value.Date + hora;
        return _form.DataVencimento.Value.Date;
    }

    private void Salvar()
    {
        if (string.IsNullOrWhiteSpace(_form.Titulo)) return;

        var dataHora = CombinarDataHora();

        if (_tarefaEditando == null)
        {
            TarefaService.Adicionar(new Tarefa
            {
                Titulo               = _form.Titulo.Trim(),
                Descricao            = _form.Descricao,
                DataVencimento       = dataHora,
                Prioridade           = _form.Prioridade,
                Sinalizada           = _form.Sinalizada,
                Recorrencia          = _form.Recorrencia,
                IntervaloRecorrencia = _form.IntervaloRecorrencia,
                DiasSemanais         = SerializarDias(_form.DiasSemanais),
                RecorrenciaFim       = _form.RecorrenciaFim,
            });
        }
        else
        {
            _tarefaEditando.Titulo               = _form.Titulo.Trim();
            _tarefaEditando.Descricao            = _form.Descricao;
            _tarefaEditando.DataVencimento       = dataHora;
            _tarefaEditando.Prioridade           = _form.Prioridade;
            _tarefaEditando.Sinalizada           = _form.Sinalizada;
            _tarefaEditando.Recorrencia          = _form.Recorrencia;
            _tarefaEditando.IntervaloRecorrencia = _form.IntervaloRecorrencia;
            _tarefaEditando.DiasSemanais         = SerializarDias(_form.DiasSemanais);
            _tarefaEditando.RecorrenciaFim       = _form.RecorrenciaFim;
            TarefaService.SalvarAlteracoes();
        }

        FecharModal();
    }

    private void ToggleConcluida(Tarefa tarefa) => TarefaService.ToggleConcluida(tarefa);

    private void ToggleSinalizar(Tarefa tarefa)
    {
        tarefa.Sinalizada = !tarefa.Sinalizada;
        TarefaService.SalvarAlteracoes();
    }

    private void Excluir(Tarefa tarefa) => TarefaService.Excluir(tarefa);
}
